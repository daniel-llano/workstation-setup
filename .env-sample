# dev-setup.sh / dev-setup.ps1 settings
#
# Shared by both the Ubuntu (dev-setup.sh) and Windows 11 (dev-setup.ps1)
# versions of this bootstrapper - same file, same KEY=VALUE format.
#
# Copy this file to ".env" (same folder as the script) and fill in real
# values. Neither script uploads, curls, or sources this file as code - it's
# parsed as strict KEY=VALUE lines only. dev-setup.sh tightens it to file
# mode 600 automatically if it finds it looser than that; dev-setup.ps1 does
# the equivalent with icacls.
#
# Sections below are written from dev-setup.sh's (Ubuntu) perspective by
# default - a "On Windows:" note under a section calls out anywhere
# dev-setup.ps1's behavior actually differs, rather than duplicating the
# whole file. No note under a section means both scripts use that key the
# same way.
#
#   cp .env-sample .env
#   chmod 600 .env
#   $EDITOR .env
#
# Every value below is optional - leave a step's keys empty and dev-setup.sh
# just skips (or falls back to asking interactively for) that piece of setup.
#
# Unification: EMAIL is a single shared value reused as the default for every
# app below that would otherwise want an email address (GIT_USER_EMAIL,
# DWSERVICE_USER), so you only type it once. Usernames stay per-app on
# purpose - your Linux login (REMOTE_USER), your git display name
# (GIT_USER_NAME) and your DWService account (DWSERVICE_USER) are rarely the
# same string, so each has its own key. Set EMAIL and any per-app override
# will win over it.

# ==============================================================================
# Shared identity
# ==============================================================================

# Reused as the default for GIT_USER_EMAIL and DWSERVICE_USER below whenever
# those are left empty. Set it once here, or leave it empty and set each of
# those individually instead.
EMAIL=

# ==============================================================================
# Git + GitHub CLI  (step: git_gh)
# ==============================================================================

# Sets `git config --global user.name` / `user.email` non-interactively. If
# both are left empty here, dev-setup.sh falls back to asking for them on the
# console the way it always did (skipped entirely in -y/non-interactive runs).
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional: a GitHub personal access token (classic or fine-grained; 'repo'
# and 'read:org' scopes cover most workflows) lets `gh auth login` run
# non-interactively instead of opening a browser prompt. Create one at
# https://github.com/settings/tokens . Leave empty to run `gh auth login`
# by hand later - the gh CLI still gets installed either way.
GH_TOKEN=

# ==============================================================================
# Remote access - SSH + GNOME Remote Desktop + VNC
# (steps: remote_ssh, remote_gnome_desktop, remote_vnc)
# ==============================================================================

# Linux user. The script NEVER creates this account automatically: it prints
# whether the name already exists, then asks [y/N] before create/password
# reset. -y/--yes never creates or resets OS logins (uses your current
# account instead). Used for:
#   - SSH login (the OS account you confirmed)
#   - GNOME Remote Desktop / VNC protocol credentials (not a new OS user)
REMOTE_USER=

# Plaintext password for REMOTE_USER above. Also the default RustDesk
# permanent access password unless RUSTDESK_PASSWORD is set below.
REMOTE_PASSWORD=

# On Windows: same confirm-before-create rule. REMOTE_USER/REMOTE_PASSWORD
# are offered as the name of an *existing* local account to add to
# Administrators + Remote Desktop Users after you confirm; a new account is
# only created if you type y at that prompt. TightVNC Server and Ubuntu
# GNOME/TigerVNC (remote_vnc) use REMOTE_PASSWORD as the VNC password
# (not a new OS login).
# TIMEZONE (optional, both OS): an IANA name on Ubuntu (e.g. Europe/Madrid) or a
# Windows tzutil id (e.g. "Romance Standard Time"). Empty leaves the clock alone.
# NIGHT_LIGHT_STRENGTH (optional, both OS): Night Light / blue-light filter
# warmth percent for desktop_prefs (0=cool/6500K, 100=warm/1200K). Default 20.
# Schedule is set for the full day (always on).

# ==============================================================================
# Desktop appearance  (steps: desktop_prefs; Windows also win11_cleanup)
# ==============================================================================
TIMEZONE=
NIGHT_LIGHT_STRENGTH=20

# PACKAGEKIT_MODE (Ubuntu only): how to handle PackageKit holding apt locks.
#   auto  (default) - stop packagekit.service before apt; offer to mask if it
#         keeps coming back. Never deletes lock files. Leaves unattended-upgrades on.
#   stop  - stop PackageKit for this run only (no mask prompt).
#   mask  - stop and mask packagekit.service (terminal apt is primary; restore with
#         sudo systemctl unmask packagekit.service && sudo systemctl start packagekit.service).
#   leave - never touch PackageKit.
PACKAGEKIT_MODE=auto

# ==============================================================================
# RustDesk  (step: remote_rustdesk)
# ==============================================================================

# Optional: a separate permanent-access password for RustDesk, if you want
# it to differ from REMOTE_PASSWORD. Falls back to REMOTE_PASSWORD if left
# empty. This is the only RustDesk credential dev-setup.sh can set for you -
# RustDesk's public server has no scriptable email/password account login
# (only OAuth buttons in its GUI), so there's nothing else to automate here.
RUSTDESK_PASSWORD=

# Optional, reference only - dev-setup.sh does not read or use this. Not a
# functional RustDesk login (see note above); a place to jot down which
# RustDesk-account email this device's permanent password above belongs to,
# for your own bookkeeping.
RUSTDESK_USER=

# Which RustDesk build to install - see
# https://rustdesk.com/blog/unattended-remote-access-wayland/ :
#   auto  (default, or leave empty) - the regular stable release, except on
#         Ubuntu 26+ where GNOME dropped its X11 session entirely and
#         RustDesk's older best-effort Wayland capture has no X11 fallback
#         left - there, use RustDesk's newer "unattended-wayland" preview
#         build instead (true unattended access, works from the GDM login
#         screen after reboot).
#   true  - always use the unattended-wayland preview build.
#   false - always use the regular stable release.
RUSTDESK_WAYLAND_PREVIEW=
# On Windows: not read at all - this is a GNOME/Wayland-only distinction
# with no Windows equivalent. remote_rustdesk always installs RustDesk's
# regular Windows release there.

# ==============================================================================
# DWService  (step: remote_dwservice, interactive wizard only)
# ==============================================================================

# Silent/unattended installation is a business/org-account feature and is NOT
# available for personal/normal accounts (confirmed with DWService support).
# This script only offers the interactive installer:
#   ./dev-setup.sh --only=remote_dwservice
#   .\dev-setup.ps1 -Only remote_dwservice
# It copies DWSERVICE_KEY (or DWSERVICE_PASSWORD if no key) to the clipboard,
# then runs the wizard so you can paste when asked. Legacy alias
# remote_dwservice_manual still maps to this step.
#
# Create a device key in your DWService account and set DWSERVICE_KEY, or leave
# empty and type the code by hand in the wizard.
DWSERVICE_KEY=
# Defaults to EMAIL above if left empty - DWService accounts are normally
# identified by email address.
DWSERVICE_USER=
DWSERVICE_PASSWORD=

# On Windows: same keys. Uses Set-Clipboard; prefer an elevated shell if the
# wizard needs to register the DWAgent Windows service.

# ==============================================================================
# Battery charge limit  (step: battery_charge_limit)
# ==============================================================================

# Caps charging around this percentage instead of always topping the
# battery up to 100% - one of the best-documented ways to slow long-term
# lithium battery wear. Leave empty for the default of 80.
#
# On Ubuntu this is applied directly on laptops whose kernel driver exposes a
# charge-threshold sysfs control (ThinkPads, and increasingly ASUS/Dell/
# Lenovo IdeaPad/Huawei/System76 models on a recent kernel), and reapplied on
# every boot by a systemd unit. Both scripts report battery wear first.
BATTERY_CHARGE_LIMIT=
# On Windows this value is advisory only: Windows has no OS-level
# charge-threshold API at all (the cap lives in the embedded controller), so
# battery_charge_limit identifies your laptop vendor, offers to install the
# free tool that can set it (G-Helper for ASUS, Lenovo Vantage / Legion
# Toolkit, Dell Optimizer, MSI Center), or names the exact UEFI setting.
# You still set the percentage inside that tool or in firmware.

# ==============================================================================
# Dock pinning  (step: pin_apps)
# ==============================================================================
#
# One flag per GUI app dev-setup.sh can install - controls ONLY whether
# pin_apps pins its icon to the GNOME dock, not whether the app itself gets
# installed (that's still controlled the normal way: interactive confirm,
# -y/--only/--skip). Every flag defaults to true when left empty/unset, so
# an .env with none of these set behaves exactly like earlier versions of
# this script (which pinned everything it found installed, unconditionally).
#
# Each run, pin_apps re-evaluates every flag below against what's actually
# installed and re-syncs the dock to match:
#   - true  + app installed  -> pinned (added if missing)
#   - false + previously pinned by this script -> unpinned (removed)
#   - true  + app not installed -> skipped, with a warning
# Only icons this script has pinned before are ever touched - anything else
# already on your dock (Files, Settings, apps you pinned by hand) is left
# alone. Terminal is always kept pinned when found; dev-setup.sh doesn't
# install it, so there's no flag for it.
#
# On Windows: same flags, different mechanism and a real limitation - since
# the 1809 shell update, Windows 11 has no supported API for scripted
# taskbar pinning at all (right-click -> Pin to taskbar by hand is the only
# fully reliable option). pin_apps there does two things instead:
#   1. Always creates a Start Menu shortcut for each true+installed app
#      (fully reliable, this part always works)
#   2. Also writes a taskbar layout file (%LOCALAPPDATA%\Microsoft\Windows\
#      Shell\LayoutModification.xml) using the same official schema Windows
#      itself uses for enterprise-managed taskbar provisioning - but applied
#      per-user without the Group Policy/Intune deployment path that schema
#      normally goes through. This is a best-effort, unsupported use of a
#      supported file format, and needs a sign-out/sign-in (or a manual
#      explorer.exe restart from Task Manager) to take effect - dev-setup.ps1
#      deliberately doesn't restart Explorer for you, since that would
#      close and reopen the taskbar/desktop for your whole session
#      unannounced. If it doesn't take effect on your build, the Start Menu
#      shortcuts from step 1 are still there as a fallback.
PIN_VSCODE=true
PIN_CURSOR=true
PIN_CHATGPT=true
PIN_CHROME=true
PIN_LIBREOFFICE=true
PIN_POSTMAN=true
PIN_REMMINA=true
PIN_SLACK=true
PIN_TEAMS=true
PIN_NOTION=true
PIN_PUMBLE=true
PIN_LINEAR=true
PIN_CLOCKIFY=true
# Controls both the text editor (gnome-text-editor/gedit) and PDF viewer
# (evince) icons together, matching the editor_pdf step installing both.
# On Windows: same, but for Notepad++ and SumatraPDF (editor_pdf's Windows
# equivalent) instead.
PIN_EDITOR_PDF=true

# ==============================================================================
# Not configurable via .env, by design
# ==============================================================================
# Slack, Microsoft Teams, Notion, Pumble, Linear and Clockify are installed
# by dev-setup.sh but authenticate through their own OAuth/web login screens
# on first launch - there is no unattended credential dev-setup.sh could feed
# them, so they're intentionally left out of this file. Log into each one by
# hand after the install steps run. Same is true on Windows for Cursor/ChatGPT
# (their own sign-in, unrelated to REMOTE_PASSWORD/RUSTDESK_PASSWORD above).
# VNC client/server on Windows is TightVNC (free); use built-in mstsc for RDP.
#
# health_check (apt/snap update + broken-package checks, npm/pipx tool
# refresh) and path_check (PATH verification/repair) have no settings of
# their own - they act on whatever health_check/path_check find installed,
# every run. On Windows, health_check refreshes npm/pip/composer tools
# instead of npm/pipx/composer (dev-setup.ps1 installs Python tools with a
# plain global pip install, not pipx).
